# ---------------------------------------------------------------------------
# ตัวอย่างตัวแปรสภาพแวดล้อม (คัดลอกเป็น .env แล้วกรอกค่าจริง)
# ---------------------------------------------------------------------------
# หมายเหตุ: ระบบอ่านไฟล์ .env อัตโนมัติตอนเปิดแอป (python-dotenv)
#           ค่าที่ตั้งใน environment จริงจะมีผลก่อนค่าในไฟล์
# ในโหมดพัฒนาทั่วไป (ต้องไม่ใช้กับ Production)
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE=0

# ---------------------------------------------------------------------------
# ล็อกอินด้วย Google (OAuth 2.0) — อ่านรายละเอียดการตั้งได้ใน README
# ---------------------------------------------------------------------------
# ไปที่ https://console.cloud.google.com -> Credentials -> OAuth client ID
#   - ประเภท: Web application
#   - URI ที่อนุญาต:
#       http://localhost:8000/accounts/google/login/callback/
#   - ใช้คำสั่งต่อไปนี้สร้างปุ่ม + SocialApp ในฐานข้อมูล:
#       python manage.py create_google_app
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# ตัวเลือกขั้นสูง (ปล่อยว่าง/ไม่ตั้งค่าก็ได้)
# ---------------------------------------------------------------------------
# Production ต้องขึ้นต้นด้วย https:// ตามโดเมนจริง เช่น https://example.com
# CORS_ALLOWED_ORIGINS=https://example.com

# ไว้หลัง reverse proxy (nginx/Caddy) เท่านั้น — 1 = ยอมรับ X-Forwarded-For
# จาก proxy เพื่อให้ rate limit นับ IP ของผู้ใช้จริง (ถ้าเปิดตรงๆ โดยไม่มี proxy
# คนนอกจะปลอม header ได้) ค่าเริ่มต้น: ปิด (ใช้ IP ของ TCP peer)
# DJANGO_TRUSTED_PROXY=1

# Cache backend — ค่าเริ่มต้น: LocMemCache เมื่อ DEBUG=true,
# DatabaseCache (ตาราง restaurant_cache) เมื่อ DEBUG=false
# ต้องการ Redis: DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=restaurant_cache

# จำกัดความถี่ run_all() ตอนเรียกผ่าน view (วินาที, 0 = ไม่จำกัด)
# Docker compose ตั้งค่า 10 ให้แล้ว
# DJANGO_AUTOMATION_MIN_INTERVAL=10

# ที่อยู่ไฟล์ SQLite (Docker mount volume ไว้ที่ /data — ไม่ต้องตั้งเองนอกจาก custom deploy)
# DJANGO_SQLITE_PATH=/data/db.sqlite3

# ---------------------------------------------------------------------------
# ฐานข้อมูล PostgreSQL (แนะนำสำหรับ Production — ไม่ตั้ง = ใช้ SQLite)
# ---------------------------------------------------------------------------
# ข้อดี: row lock จริงด้วย SELECT ... FOR UPDATE (กันตัดสต็อกซ้ำ/ออเดอร์ซ้ำ
#        แบบ race จริง ๆ บน gunicorn หลาย worker) + connection pooling
# ต้อง pip install "psycopg[binary]" แล้ว migrate บน DB ใหม่
# DJANGO_DB_ENGINE=postgres
# DJANGO_POSTGRES_DB=restaurant
# DJANGO_POSTGRES_USER=restaurant
# DJANGO_POSTGRES_PASSWORD=change-me
# DJANGO_POSTGRES_HOST=127.0.0.1
# DJANGO_POSTGRES_PORT=5432
# DJANGO_POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Sentry (รายงาน exception ขึ้น Sentry — ไม่ตั้ง DSN = ปิด ไม่กระทบอะไร)
# ---------------------------------------------------------------------------
# DJANGO_SENTRY_DSN=https://xxxxxx@o0.ingest.sentry.io/0
# DJANGO_SENTRY_TRACES_RATE=0.0
# DJANGO_SENTRY_ENVIRONMENT=production

# อีเมล — default ส่งลง terminal (console) เหมาะกับ Development
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=noreply@restaurant.local

# LINE Notify Token สำหรับแจ้งเตือนออเดอร์/จองโต๊ะ/รีวิว (เว้นว่าง = ปิด)
# LINE_NOTIFY_TOKEN=